<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\API\API.csproj" />
    <!-- The Cron host owns email delivery; alias it so its top-level Program doesn't clash with the
         API's, while still letting the test fixture boot the Cron pipeline in-process. -->
    <ProjectReference Include="..\Cron\Cron.csproj" Aliases="cronhost" />
  </ItemGroup>

  <!-- Props -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <!-- The in-process Cron host loads these Liquid templates by relative path; copy them next to the
       test binaries so they resolve against the test working directory. -->
  <ItemGroup>
    <Content Include="..\Cron\SmtpTemplates\*.liquid" Link="SmtpTemplates\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Git stuff -->
  <Target Name="SetHash" AfterTargets="InitializeSourceControlInformation">
    <ItemGroup>
      <AssemblyAttribute Include="OpenShock.Common.Utils.GitHashAttribute">
        <_Parameter1>$(SourceRevisionId)</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
