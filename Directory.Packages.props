<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets us pin transitive dependencies (e.g. to pick up a security fix) from here -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="AspNet.Security.OAuth.Discord" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Twitter" Version="10.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Fluid.Core" Version="2.40.0" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageVersion Include="IDisposableAnalyzers" Version="4.0.8" />
    <PackageVersion Include="MailKit" Version="4.18.0" />
    <PackageVersion Include="MessagePack" Version="3.1.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.10.0" />
    <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-preview.6" />
    <PackageVersion Include="NRedisStack" Version="1.7.4" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="OpenShock.Internal.Common" Version="1.1.0" />
    <PackageVersion Include="OpenShock.Internal.AspNet" Version="1.1.0" />
    <PackageVersion Include="OpenShock.Internal.DynamicLinq" Version="1.1.0" />
    <PackageVersion Include="OpenShock.Serialization.Flatbuffers" Version="2.1.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageVersion Include="Redis.OM" Version="1.3.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.4" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Grafana.Loki" Version="9.0.2" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <!-- Transitive via NRedisStack; 3.0.25 reflects over MulticastDelegate._invocationList, which no longer
         exists on .NET 11 and aborts the process (MissingFieldException on the connection-failed handler). -->
    <PackageVersion Include="StackExchange.Redis" Version="3.2.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.15.0" />
    <PackageVersion Include="TUnit" Version="1.68.4" />
    <PackageVersion Include="Z.EntityFramework.Plus.EFCore" Version="10.105.8.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'">
    <!-- Transitive from Microsoft.AspNetCore.DataProtection.EntityFrameworkCore; older versions have known CVEs, force the patched version.
         Scoped to non-Web-SDK projects: Sdk.Web projects already get the patched assembly via the ASP.NET Core shared framework and NuGet
         prunes an explicit reference there (NU1510). -->
    <GlobalPackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>
</Project>