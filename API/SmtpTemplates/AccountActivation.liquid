    <!--body-->
    <table
      border="0"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
      align="center">
      <tbody>
        <tr>
          <td
            style='font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;line-height:1.6;background-color:#f4f5f7;color:#1f2329;margin:0;padding:0;-webkit-font-smoothing:antialiased'>
            <table
              align="center"
              width="100%"
              border="0"
              cellpadding="0"
              cellspacing="0"
              role="presentation"
              style="max-width:560px;margin:32px auto;background-color:#ffffff;border:1px solid #e4e7eb;border-radius:8px;overflow:hidden">
              <tbody>
                <tr style="width:100%">
                  <td>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation"
                      style="padding:20px 32px;background-color:#111827;color:#ffffff">
                      <tbody>
                        <tr>
                          <td>
                            <p
                              style="font-size:18px;line-height:24px;margin:0;font-weight:700;letter-spacing:0.5px;color:#ffffff;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                              OpenShock
                            </p>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation"
                      style="padding:28px 32px 8px">
                      <tbody>
                        <tr>
                          <td>
                            <h1
                              style="color:#1f2329;font-size:22px;font-weight:600;margin:0 0 16px;line-height:1.3">
                              Activate your account
                            </h1>
                            <p
                              style="font-size:15px;line-height:24px;color:#1f2329;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">
                              Hello
                              <!-- -->{{ To.Name }}<!-- -->,
                            </p>
                            <p
                              style="font-size:15px;line-height:24px;color:#1f2329;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">
                              Thanks for signing up! Confirm this is your email
                              address to finish setting up your OpenShock
                              account.
                            </p>
                            <table
                              align="center"
                              width="100%"
                              border="0"
                              cellpadding="0"
                              cellspacing="0"
                              role="presentation"
                              style="padding:8px 0 20px">
                              <tbody>
                                <tr>
                                  <td>
                                    <a
                                      href="{{ ActivationLink }}"
                                      style="color:#ffffff;text-decoration-line:none;display:inline-block;padding:12px 24px;background-color:#111827;font-size:15px;font-weight:600;text-decoration:none;border-radius:6px"
                                      target="_blank"
                                      >Activate account</a
                                    >
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                            <p
                              style="font-size:13px;line-height:24px;color:#5a6473;margin:0 0 6px;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">
                              If the button above doesn&#x27;t work, copy and
                              paste this link into your browser:
                            </p>
                            <a
                              href="{{ ActivationLink }}"
                              style='color:#1f6feb;text-decoration-line:none;font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;font-size:12px;word-break:break-all;margin:0 0 20px;display:block'
                              target="_blank"
                              >{{ ActivationLink }}</a
                            >
                            <p
                              style="font-size:14px;line-height:24px;background-color:#fff8e1;border:1px solid #f0c419;border-radius:6px;padding:12px 16px;margin:0 0 20px;color:#5a4500;margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0">
                              If you did not sign up for OpenShock, you can
                              safely ignore this email. No account will be
                              created without confirmation.
                            </p>
                            <p
                              style="font-size:15px;line-height:24px;color:#1f2329;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">
                              Thank you,<br />The OpenShock Team
                            </p>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation"
                      style="padding:20px 32px 24px;background-color:#fafbfc;border-top:1px solid #e4e7eb">
                      <tbody>
                        <tr>
                          <td>
                            <p
                              style="font-size:12px;line-height:1.5;color:#8a93a3;margin:0 0 6px;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">
                              OpenShock will never ask for your password, API
                              token, or any other credentials by email. If a
                              message appears to come from us and asks for
                              these, do not respond.
                            </p>
                            <p
                              style="font-size:12px;line-height:1.5;color:#8a93a3;margin:0 0 6px;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">
                              Need help? Visit<!-- -->
                              <a
                                href="https://openshock.app"
                                style="color:inherit;text-decoration-line:none"
                                target="_blank"
                                >openshock.app</a
                              >.
                            </p>
                            <p
                              style="font-size:12px;line-height:1.5;color:#8a93a3;margin:0 0 6px;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">
                              © OpenShock. This is an automated message, please
                              do not reply.
                            </p>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
